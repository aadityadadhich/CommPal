# ============================================================================
# CommPal — Root Environment & API Keys Configuration Template (.env.example)
# ============================================================================
# Copy this file to .env and fill in any optional external API keys.

PROJECT_NAME=CommPal
DATABASE_URL=sqlite:///./commpal.db

# 1. PayPal REST API v2 ("mock" works out-of-the-box; "sandbox" uses live PayPal Sandbox API)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# 2. Conversational AI ("ollama", "gemini", or "offline")
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. Optional: Channel3 Live Product Search SDK
CHANNEL3_API_KEY=

# 4. Security & Internal Signing
SECRET_KEY=commpal-hackathon-inviolable-secret-key-2026
INTERNAL_TICK_TOKEN=tick-secret-token
