# CommPal Environment Configuration
PROJECT_NAME=CommPal
DATABASE_URL=sqlite:///./commpal.db

# 1. Conversational AI (Ollama qwen2.5:7b Primary -> Gemini Secondary -> Offline Fallback)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: Google Gemini API (used if LLM_PROVIDER=gemini or Ollama is unreachable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. PayPal Sandbox / Mock E-Wallet ("mock" works out-of-the-box; "sandbox" calls PayPal REST API)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# 3. Optional: Channel3 Live Product Search SDK
CHANNEL3_API_KEY=

# 4. Security & Webhook Signing
SECRET_KEY=commpal-hackathon-inviolable-secret-key-2026
INTERNAL_TICK_TOKEN=tick-secret-token
